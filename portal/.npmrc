# drizzle-orm declares many database drivers (including @prisma/client) as
# OPTIONAL peer dependencies. We use only the `postgres` (postgres.js) driver,
# so skip auto-installing peer deps — this keeps the Prisma prerelease (which
# needs the binaries.prisma.sh download this build blocks) out of the tree.
# Our real peers (react, react-dom for next, etc.) are direct dependencies.
legacy-peer-deps=true
