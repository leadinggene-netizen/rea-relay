# =============================================================================
# rea-relay portal — environment variables
# Copy to `.env` (or `.env.local`) and fill in. `.env*` is gitignored; this
# example file is the only env file committed.
# =============================================================================

# --- Database (Prisma) -------------------------------------------------------
# PostgreSQL connection string. Prisma reads this for `migrate` / `db push` and
# at runtime. NOT required to `prisma generate`, `prisma validate`, build, or
# run the unit tests (the Prisma client is mocked in tests).
DATABASE_URL="postgresql://user:password@localhost:5432/rea_relay?schema=public"

# --- Auth.js (NextAuth v5) ---------------------------------------------------
# Required in every environment. Generate with: `openssl rand -base64 32`.
AUTH_SECRET="replace-me-with-a-32-byte-base64-secret"
# Public base URL of the portal. Optional in dev (auto-detected).
# AUTH_URL="http://localhost:3000"

# Enable the dev-only Credentials login (email + any password -> a stub user).
# It is ALSO enabled automatically whenever NODE_ENV !== 'production'.
# Set to 1 to force-enable it (e.g. in a preview deploy). NEVER set in prod.
AUTH_DEV_LOGIN="1"

# --- Microsoft Entra ID (Azure AD) OAuth -------------------------------------
# Production sign-in provider. Create an App Registration in Entra ID:
#   1. Azure Portal -> Entra ID -> App registrations -> New registration.
#   2. Redirect URI (Web): https://<your-domain>/api/auth/callback/microsoft-entra-id
#   3. Copy Application (client) ID       -> AZURE_AD_CLIENT_ID
#   4. Certificates & secrets -> new client secret -> value -> AZURE_AD_CLIENT_SECRET
#   5. Directory (tenant) ID              -> AZURE_AD_TENANT_ID
# Leave blank in local dev to hide the Entra button and use the dev login.
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# --- Relay admin API (the Go relay backend) ----------------------------------
# The portal's provisioning calls the relay's /admin endpoints with this Bearer
# token. Must match REA_ADMIN_TOKEN configured on the relay. Not contacted at
# build time — only when provisioning runs.
RELAY_ADMIN_URL="http://localhost:8080"
RELAY_ADMIN_TOKEN="replace-me-with-the-relay-admin-token"

# --- Stripe (billing — wired in a later slice) -------------------------------
# Placeholders; checkout is stubbed in this scaffold.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Per-plan price IDs (set after creating products/prices in the Stripe dashboard).
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_ADVANCED=""
STRIPE_PRICE_PRO=""
