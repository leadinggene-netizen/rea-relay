# =============================================================================
# rea-relay portal — environment variables
# Copy to `.env` (or `.env.local`) and fill in. `.env*` is gitignored; this
# example file is the only env file committed.
# =============================================================================

# --- Database (Drizzle ORM / postgres.js) ------------------------------------
# PostgreSQL connection string. Read by `drizzle-kit migrate` and at runtime.
# NOT required to `drizzle-kit generate` (schema-diff only), build, or run the
# unit tests (the db client is mocked / unused in tests).
DATABASE_URL="postgresql://user:password@localhost:5432/rea_relay"

# --- Auth.js (NextAuth v5) ---------------------------------------------------
# Required in every environment. Generate with: `openssl rand -base64 32`.
AUTH_SECRET="replace-me-with-a-32-byte-base64-secret"
# Public base URL of the portal. Optional in dev (auto-detected).
# AUTH_URL="http://localhost:3000"

# Enable the dev-only Credentials login (email + any password -> a stub user).
# It is ALSO enabled automatically whenever NODE_ENV !== 'production'.
# Set to 1 to force-enable it (e.g. in a preview deploy). NEVER set in prod.
AUTH_DEV_LOGIN="1"

# --- Microsoft Entra ID (Azure AD) OAuth -------------------------------------
# Production sign-in provider. Create an App Registration in Entra ID:
#   1. Azure Portal -> Entra ID -> App registrations -> New registration.
#   2. Redirect URI (Web): https://<your-domain>/api/auth/callback/microsoft-entra-id
#   3. Copy Application (client) ID       -> AZURE_AD_CLIENT_ID
#   4. Certificates & secrets -> new client secret -> value -> AZURE_AD_CLIENT_SECRET
#   5. Directory (tenant) ID              -> AZURE_AD_TENANT_ID
# Leave blank in local dev to hide the Entra button and use the dev login.
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# --- Relay admin API (the Go relay backend) ----------------------------------
# The portal's provisioning calls the relay's /admin endpoints with this Bearer
# token. Must match REA_ADMIN_TOKEN configured on the relay. Not contacted at
# build time — only when provisioning runs. When EITHER is unset, activation
# provisioning logs and skips (local billing still works without a relay).
RELAY_ADMIN_URL="http://localhost:8080"
RELAY_ADMIN_TOKEN="replace-me-with-the-relay-admin-token"

# --- Secret store (broker credentials) ---------------------------------------
# LocalSecretStore (dev/default) encrypts broker creds with AES-256-GCM using a
# base64-encoded 32-byte key. Generate one with: `openssl rand -base64 32`.
# Required only when storing/reading broker credentials via LocalSecretStore
# (i.e. when AZURE_KEY_VAULT_URL is NOT set). Not needed to build or test.
SECRET_STORE_KEY=""
# When set, the portal selects the (not-yet-implemented, §4) Key Vault secret
# store instead of LocalSecretStore. Leave UNSET in dev.
AZURE_KEY_VAULT_URL=""

# --- Stripe (subscription billing via hosted Checkout) -----------------------
# Dashboard setup (test mode first):
#   1. Create ONE Product per plan (Starter / Advanced / Pro), each with a
#      recurring monthly Price ($29 / $69 / $149) -> copy each price id (price_...)
#      into STRIPE_PRICE_STARTER / _ADVANCED / _PRO below.
#   2. Developers -> API keys: Secret key (sk_...) -> STRIPE_SECRET_KEY,
#      Publishable key (pk_...) -> STRIPE_PUBLISHABLE_KEY.
#   3. Developers -> Webhooks: add an endpoint at
#      https://<your-domain>/api/stripe/webhook subscribed to
#      checkout.session.completed, customer.subscription.created|updated|deleted
#      -> copy its signing secret (whsec_...) into STRIPE_WEBHOOK_SECRET.
#      For local testing: `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# None of these are required to build or run the unit tests (SDK + DB mocked).
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Per-plan recurring Price IDs (price_...), one per tier.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_ADVANCED=""
STRIPE_PRICE_PRO=""
